# GEMINI_API_KEY: Required ONLY for optional server-side AI drafting & diagram generation.
# Configure via AI Studio Settings > Secrets (or Cloud Run Secret Manager). Keep server-side only.
GEMINI_API_KEY=""

# APP_URL: Canonical public origin of the hosted ECONOVA PWA (used for certificate verification QR links).
# AI Studio injects this automatically in runtime previews.
APP_URL=""

# SESSION_SECRET: Required in production for signing HttpOnly session cookies across instances.
# Generate a random 64-char hex / 32+ byte string via CSPRNG and store in AI Studio Secrets / Secret Manager.
SESSION_SECRET=""

# SUPABASE_DB_URL (or DATABASE_URL): Required for hosted Supabase PostgreSQL persistence.
# Use Supabase's Transaction/Session Pooler Postgres URI (sslmode=require) from Supabase Dashboard > Project Settings > Database.
# Configure in AI Studio Settings > Secrets; never put database credentials in frontend code.
SUPABASE_DB_URL=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional Supabase project API URL and server-only service_role key
# for Supabase administrative tooling / Storage integration. Never prefix with VITE_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ENABLE_DEMO_SANDBOX: Set to "true" ONLY in non-production sandboxes if evaluating built-in demo accounts.
# Leave unset or "false" when serving real learners.
ENABLE_DEMO_SANDBOX="false"
